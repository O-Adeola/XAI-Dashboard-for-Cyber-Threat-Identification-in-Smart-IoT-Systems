@startuml
left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor #EAF2F8
    BorderColor #1A40A3
    ArrowColor #1A40A3
}

actor "Security Analyst" as Analyst

rectangle "Use Case Diagram for XAI Threat Detection Dashboard" {

    usecase "Select Dataset" as UC1
    usecase "View Dataset Analysis" as UC2
    usecase "Select ML Model" as UC3
    usecase "Compare ML Models" as UC4
    usecase "Run Prediction" as UC5
    usecase "View Prediction Explanation" as UC6

    usecase "View Dataset Overview" as UC7
    usecase "View Data Quality" as UC8
    usecase "View Class Distribution" as UC9
    usecase "Explore Features" as UC10

    usecase "View Model Performance" as UC11
    usecase "View Confusion Matrix" as UC12
    usecase "View Classification Report" as UC13

    usecase "Use Saved Evaluation Sample" as UC14
    usecase "Upload CSV Dataset File" as UC15
    usecase "Run Selected Network Record for Prediction" as UC16
    usecase "View Prediction Output" as UC17

    usecase "View Local Explanation" as UC18
    usecase "View Global Feature Importance" as UC19
    usecase "View Plain-Language Reasoning" as UC20

    usecase "Provide Input Source" as UC21
}

Analyst --> UC1
Analyst --> UC2
Analyst --> UC3
Analyst --> UC4
Analyst --> UC5
Analyst --> UC6

UC2 ..> UC7 : <<include>>
UC2 ..> UC8 : <<include>>
UC2 ..> UC9 : <<include>>
UC2 ..> UC10 : <<include>>

UC21 <|-- UC14
UC21 <|-- UC15

UC4 ..> UC11 : <<include>>
UC4 ..> UC12 : <<include>>
UC4 ..> UC13 : <<include>>

UC5 ..> UC21 : <<include>>
UC5 ..> UC16 : <<include>>
UC5 ..> UC17 : <<include>>

UC6 ..> UC18 : <<include>>
UC6 ..> UC19 : <<include>>
UC6 ..> UC20 : <<include>>
@enduml